{{ if eq .chezmoi.os "windows" -}}
# run_once_install-packages-windows.ps1
# Installs Windows packages via winget.
# Chezmoi re-runs this when file content changes — bump the version below to force a re-run.
# version: 5

$packages = @(
    # Shell / terminal
    "Microsoft.WindowsTerminal",
    "Microsoft.PowerShell",

    # Editor
    "Neovim.Neovim",
    "Microsoft.VisualStudioCode",

    # Version control
    "Git.Git",
    "GitHub.cli",

    # Tiling WM + status bar
    "LGUG2Z.komorebi",
    "LGUG2Z.whkd",
    "AmN.yasb",

    # Languages / runtimes
    # node/go/python are managed by mise (see ~/.config/mise/config.toml), not winget.
    "jdx.mise",
    "Rustlang.Rustup",

    # CLI tools
    "junegunn.fzf",
    "ajeetdsouza.zoxide",
    "sharkdp.bat",
    "eza-community.eza",
    "BurntSushi.ripgrep.MSVC",
    "jqlang.jq",
    "tldr-pages.tlrc",

    # Fonts
    "Nerd-Fonts.FiraCode",

    # GUI apps — parity with macOS Brewfile / Linux installer
    "Brave.Brave",
    "Bitwarden.Bitwarden",
    "Discord.Discord",
    "Obsidian.Obsidian",
    "OBSProject.OBSStudio",
    "SoftFever.OrcaSlicer",

    # Streaming / Elgato — Stream Deck profiles & Wave Link backups live in repo elgato/
    "Elgato.StreamDeck",
    "Elgato.WaveLink"
)

foreach ($pkg in $packages) {
    Write-Host "Installing $pkg..."
    winget install --id $pkg --exact --accept-source-agreements --accept-package-agreements --silent 2>&1
}

# Spotify — winget REFUSES to install it from an elevated/admin prompt, and the
# bootstrap runs elevated. Try non-elevated-friendly; if it fails, tell the user.
if (-not (Get-Command spotify -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Spotify..."
    $sp = winget install --id Spotify.Spotify --exact --accept-source-agreements --accept-package-agreements --silent 2>&1
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Spotify install failed (winget blocks it when elevated). Run this in a NON-admin PowerShell: winget install --id Spotify.Spotify -e"
    }
}

# Claude Code — installed via the official native installer (not in winget).
if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Claude Code..."
    irm https://claude.ai/install.ps1 | iex
}

# Persistent PATH: ensure ~/.local/bin (Claude Code + native installers land here)
# is on the USER PATH as a FOLDER, so `claude` and the helper scripts resolve in
# every shell — Windows PowerShell 5.1 and GUI launches included, not just pwsh.
# (The pwsh profile also prepends it per-session; this makes it durable.)
$localBin = Join-Path $HOME ".local\bin"
$userPath = [System.Environment]::GetEnvironmentVariable("PATH", "User")
$parts = $userPath -split ';' | Where-Object { $_ -and $_ -ne (Join-Path $localBin "claude.exe") }
if ($parts -notcontains $localBin) {
    $parts += $localBin
    [System.Environment]::SetEnvironmentVariable("PATH", ($parts -join ';'), "User")
    Write-Host "Added $localBin to the persistent user PATH."
}

# komorebi + whkd config location: BOTH tools default to looking in ~ for their
# config, but this repo keeps komorebi.json/whkdrc under ~/.config/komorebi/.
# Without these env vars komorebi silently runs on built-in DEFAULTS (no work-area
# offset, so windows tile OVER the YASB bar; wrong workspaces) and whkd crashes
# ("could not load whkdrc"), so no keybindings work.
$komoHome = Join-Path $HOME ".config\komorebi"
foreach ($var in "KOMOREBI_CONFIG_HOME", "WHKD_CONFIG_HOME") {
    if ([System.Environment]::GetEnvironmentVariable($var, "User") -ne $komoHome) {
        [System.Environment]::SetEnvironmentVariable($var, $komoHome, "User")
        Write-Host "Set $var to $komoHome."
    }
}

# Fetch the community application-specific config (applications.json) that
# komorebi.json references — improves tiling for apps that need special handling.
if (Get-Command komorebic -ErrorAction SilentlyContinue) {
    try { komorebic fetch-asc 2>&1 | Out-Null } catch { }
    # Autostart komorebi + whkd at login with the config path baked in, so it never
    # depends on env-var timing. (komorebi must start from an interactive login
    # session — it needs foreground rights — so we register autostart, not start now.)
    $komoCfg = Join-Path $komoHome "komorebi.json"
    try { komorebic enable-autostart --config "$komoCfg" --whkd 2>&1 | Out-Null } catch { }
}

# YASB status bar: register login autostart and start it now. Config lives in
# ~/.config/yasb (managed by chezmoi). Wrapped so a yasbc hiccup doesn't abort.
if (Get-Command yasbc -ErrorAction SilentlyContinue) {
    try {
        yasbc enable-autostart 2>&1 | Out-Null
        yasbc start 2>&1 | Out-Null
    } catch {
        Write-Host "YASB installed; start it manually with: yasbc start"
    }
}
{{ end -}}
