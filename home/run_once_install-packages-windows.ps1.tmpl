{{ if eq .chezmoi.os "windows" -}}
# run_once_install-packages-windows.ps1
# Installs Windows packages via winget.
# Chezmoi re-runs this when file content changes — bump the version below to force a re-run.
# version: 7

$packages = @(
    # Shell / terminal
    "Microsoft.WindowsTerminal",
    "Microsoft.PowerShell",

    # Editor
    "Neovim.Neovim",
    "Microsoft.VisualStudioCode",

    # Version control
    "Git.Git",
    "GitHub.cli",

    # Tiling WM + status bar
    "LGUG2Z.komorebi",
    "LGUG2Z.whkd",
    "AmN.yasb",

    # Languages / runtimes
    # node/go/python are managed by mise (see ~/.config/mise/config.toml), not winget.
    "jdx.mise",
    "Rustlang.Rustup",

    # CLI tools
    "junegunn.fzf",
    "ajeetdsouza.zoxide",
    "sharkdp.bat",
    "eza-community.eza",
    "BurntSushi.ripgrep.MSVC",
    "jqlang.jq",
    "tldr-pages.tlrc",

    # Fonts: FiraCode Nerd Font is NOT in winget (the only Nerd Font there is
    # DEVCOM.JetBrainsMonoNerdFont). It's installed from the Nerd Fonts release
    # further down — see the "FiraCode Nerd Font" block.

    # GUI apps — parity with macOS Brewfile / Linux installer
    "Brave.Brave",
    "Bitwarden.Bitwarden",
    "Discord.Discord",
    "Obsidian.Obsidian",
    "OBSProject.OBSStudio",
    "SoftFever.OrcaSlicer",

    # Streaming / Elgato — Stream Deck profiles & Wave Link backups live in repo elgato/
    # (Wave Link is handled separately below — v3 is an MSIX that needs the legacy
    #  Win32 v2 removed first, or winget sees "already installed" and never upgrades.)
    "Elgato.StreamDeck"
)

foreach ($pkg in $packages) {
    Write-Host "Installing $pkg..."
    winget install --id $pkg --exact --accept-source-agreements --accept-package-agreements --silent 2>&1
}

# Elgato Wave Link — version depends on the OS:
#   * v3 ships as an MSIX that requires Windows 11 (MinimumOSVersion 10.0.22000).
#   * v2.0.6 is the LAST version that runs on Windows 10 — on Win10, winget sees the
#     v3 MSIX as "no applicable installer" and correctly falls back to v2.
# On Windows 11, v2->v3 can't be a winget *upgrade* (can't cross Win32->MSIX) and a
# plain install skips when the v2 ARP entry is present, so we remove any legacy
# (non-v3) Wave Link first, then install the latest. On Windows 10 we just install
# the newest applicable (v2). Mixer settings live in %APPDATA%\Elgato\WaveLink and
# survive an uninstall either way.
Write-Host "Installing Elgato Wave Link..."
$osBuild = [int](Get-CimInstance Win32_OperatingSystem).BuildNumber
if ($osBuild -ge 22000) {
    $wlLine = winget list --id Elgato.WaveLink --exact --accept-source-agreements 2>$null |
        Select-String -Pattern 'Elgato\.WaveLink'
    if ($wlLine -and ($wlLine -notmatch '\b3\.')) {
        Write-Host "Windows 11 detected — removing legacy Wave Link before installing v3 (MSIX)..."
        winget uninstall --id Elgato.WaveLink --exact --silent --disable-interactivity 2>&1 | Out-Null
    }
} else {
    Write-Host "Windows 10 detected — Wave Link v3 needs Win11; installing latest supported (v2)."
}
winget install --id Elgato.WaveLink --exact --accept-source-agreements --accept-package-agreements --silent 2>&1
if ($LASTEXITCODE -ne 0) {
    Write-Host "Wave Link install returned $LASTEXITCODE. On Win11 retry: winget install --id Elgato.WaveLink -e --force"
}

# Spotify — winget REFUSES to install it from an elevated/admin prompt, and the
# bootstrap runs elevated. Try non-elevated-friendly; if it fails, tell the user.
if (-not (Get-Command spotify -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Spotify..."
    $sp = winget install --id Spotify.Spotify --exact --accept-source-agreements --accept-package-agreements --silent 2>&1
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Spotify install failed (winget blocks it when elevated). Run this in a NON-admin PowerShell: winget install --id Spotify.Spotify -e"
    }
}

# FiraCode Nerd Font — used by Windows Terminal + YASB (matches macOS/Linux).
# Not available via winget, so install per-user (no admin) straight from the Nerd
# Fonts GitHub release: copy the .ttf files into the user fonts folder and register
# them under HKCU. Idempotent — skips if the font is already present.
$userFontsDir = Join-Path $env:LOCALAPPDATA "Microsoft\Windows\Fonts"
if (-not (Test-Path (Join-Path $userFontsDir "FiraCodeNerdFont-Regular.ttf"))) {
    Write-Host "Installing FiraCode Nerd Font..."
    try {
        Add-Type @"
using System;
using System.Runtime.InteropServices;
public class FontInstallHelper {
  [DllImport("gdi32.dll")] public static extern int AddFontResource(string lpFileName);
  [DllImport("user32.dll")] public static extern IntPtr SendMessage(IntPtr hWnd, uint Msg, IntPtr wParam, IntPtr lParam);
}
"@
        $fontUrl = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip"
        $fontZip = Join-Path $env:TEMP "FiraCodeNF.zip"
        $fontExt = Join-Path $env:TEMP "FiraCodeNF"
        Invoke-WebRequest -Uri $fontUrl -OutFile $fontZip
        if (Test-Path $fontExt) { Remove-Item $fontExt -Recurse -Force }
        Expand-Archive -Path $fontZip -DestinationPath $fontExt -Force
        New-Item -ItemType Directory -Force -Path $userFontsDir | Out-Null
        $fontReg = "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts"
        foreach ($ttf in Get-ChildItem $fontExt -Filter *.ttf -Recurse) {
            $fontDest = Join-Path $userFontsDir $ttf.Name
            Copy-Item $ttf.FullName $fontDest -Force
            New-ItemProperty -Path $fontReg -Name "$($ttf.BaseName) (TrueType)" -Value $fontDest -PropertyType String -Force | Out-Null
            [void][FontInstallHelper]::AddFontResource($fontDest)
        }
        [void][FontInstallHelper]::SendMessage([IntPtr]0xffff, 0x001D, [IntPtr]::Zero, [IntPtr]::Zero)
        Remove-Item $fontZip, $fontExt -Recurse -Force -ErrorAction SilentlyContinue
    } catch {
        Write-Host "FiraCode Nerd Font install failed: $_ — install it manually from https://github.com/ryanoasis/nerd-fonts/releases"
    }
}

# Claude Code — installed via the official native installer (not in winget).
if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Claude Code..."
    irm https://claude.ai/install.ps1 | iex
}

# Persistent PATH: ensure ~/.local/bin (Claude Code + native installers land here)
# is on the USER PATH as a FOLDER, so `claude` and the helper scripts resolve in
# every shell — Windows PowerShell 5.1 and GUI launches included, not just pwsh.
# (The pwsh profile also prepends it per-session; this makes it durable.)
$localBin = Join-Path $HOME ".local\bin"
$userPath = [System.Environment]::GetEnvironmentVariable("PATH", "User")
$parts = $userPath -split ';' | Where-Object { $_ -and $_ -ne (Join-Path $localBin "claude.exe") }
if ($parts -notcontains $localBin) {
    $parts += $localBin
    [System.Environment]::SetEnvironmentVariable("PATH", ($parts -join ';'), "User")
    Write-Host "Added $localBin to the persistent user PATH."
}

# komorebi + whkd config location: BOTH tools default to looking in ~ for their
# config, but this repo keeps komorebi.json/whkdrc under ~/.config/komorebi/.
# Without these env vars komorebi silently runs on built-in DEFAULTS (no work-area
# offset, so windows tile OVER the YASB bar; wrong workspaces) and whkd crashes
# ("could not load whkdrc"), so no keybindings work.
$komoHome = Join-Path $HOME ".config\komorebi"
foreach ($var in "KOMOREBI_CONFIG_HOME", "WHKD_CONFIG_HOME") {
    if ([System.Environment]::GetEnvironmentVariable($var, "User") -ne $komoHome) {
        [System.Environment]::SetEnvironmentVariable($var, $komoHome, "User")
        Write-Host "Set $var to $komoHome."
    }
}

# Fetch the community application-specific config (applications.json) that
# komorebi.json references — improves tiling for apps that need special handling.
if (Get-Command komorebic -ErrorAction SilentlyContinue) {
    try { komorebic fetch-asc 2>&1 | Out-Null } catch { }
    # Autostart komorebi + whkd at login with the config path baked in, so it never
    # depends on env-var timing. (komorebi must start from an interactive login
    # session — it needs foreground rights — so we register autostart, not start now.)
    $komoCfg = Join-Path $komoHome "komorebi.json"
    try { komorebic enable-autostart --config "$komoCfg" --whkd 2>&1 | Out-Null } catch { }
}

# YASB status bar: register login autostart and start it now. Config lives in
# ~/.config/yasb (managed by chezmoi). Wrapped so a yasbc hiccup doesn't abort.
if (Get-Command yasbc -ErrorAction SilentlyContinue) {
    try {
        yasbc enable-autostart 2>&1 | Out-Null
        yasbc start 2>&1 | Out-Null
    } catch {
        Write-Host "YASB installed; start it manually with: yasbc start"
    }
}
{{ end -}}
