 /* ~/.config/rofi/simple_theme.rasi */
/* Managed by Chezmoi: {{ .chezmoi.sourceFile }} */

* {
    bg:           #282a36;
    bg-alt:       #44475a;
    fg:           #f8f8f2;
    fg-dim:       #6272a4;
    accent:       #bd93f9;
    selected-bg:  #44475a;
    selected-fg:  #f8f8f2;

    background-color: @bg;
    text-color:       @fg;
    font:             "FiraCode Nerd Font 11";
}

window {
    width:            30%;
    padding:          10px;
    border:           2px;
    border-color:     @accent;
    border-radius:    4px;
    background-color: @bg;
}

mainbox {
    border:  0;
    padding: 5px;
}

inputbar {
    children:   [ prompt, textbox-prompt-colon, entry, case-indicator ];
    spacing:    5px;
    text-color: @fg;
    padding:    5px;
    border:     0 0 1px 0;
    border-color: @fg-dim;
}

prompt {
    enabled:    true;
    text-color: @accent;
}
textbox-prompt-colon {
    enabled:    true;
    expand:     false;
    str:        "";
    text-color: @accent;
}
entry {
    text-color: @fg;
}
case-indicator {
    text-color: @fg-dim;
}

listview {
    padding:      5px;
    border:       0;
    columns:      1;
    lines:        8;
    spacing:      2px;
    fixed-height: false;
    scrollbar:    false;
}

element {
    padding:          6px 8px;
    spacing:          5px;
    border-radius:    3px;
    background-color: transparent;
}

element-text {
    text-color: inherit;
}

element.selected {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}

element-icon {
    size: 1.2em;
}
