# whkdrc — komorebi hotkey bindings
# Mirrors AeroSpace keybindings from dot_aerospace.toml.tmpl

.shell pwsh

# --- Launch apps ---
alt + shift + t  : wt
alt + shift + b  : start brave
alt + shift + f  : explorer.exe
alt + shift + q  : komorebic close

# --- Session ---
alt + shift + r      : komorebic reload-configuration
alt + shift + s      : rundll32.exe user32.dll,LockWorkStation

# --- Focus ---
alt + h          : komorebic focus left
alt + j          : komorebic focus down
alt + k          : komorebic focus up
alt + l          : komorebic focus right

# --- Move ---
alt + shift + h  : komorebic move left
alt + shift + j  : komorebic move down
alt + shift + k  : komorebic move up
alt + shift + l  : komorebic move right

# --- Resize ---
alt + oem_minus  : komorebic resize-axis horizontal decrease 50
alt + oem_plus   : komorebic resize-axis horizontal increase 50

# --- Layout ---
alt + f          : komorebic toggle-float
alt + shift + return : komorebic toggle-monocle
alt + oem_2      : komorebic cycle-layout next

# --- Workspaces ---
# Workspaces 1-4 live on monitor 0 (left), 5-9 on monitor 1 (right), so each key
# targets an explicit monitor+workspace pair (focus-monitor-workspace <mon> <ws>).
alt + 1          : komorebic focus-monitor-workspace 0 0
alt + 2          : komorebic focus-monitor-workspace 0 1
alt + 3          : komorebic focus-monitor-workspace 0 2
alt + 4          : komorebic focus-monitor-workspace 0 3
alt + 5          : komorebic focus-monitor-workspace 1 0
alt + 6          : komorebic focus-monitor-workspace 1 1
alt + 7          : komorebic focus-monitor-workspace 1 2
alt + 8          : komorebic focus-monitor-workspace 1 3
alt + 9          : komorebic focus-monitor-workspace 1 4

# --- Move to workspace ---
alt + shift + 1  : komorebic move-to-monitor-workspace 0 0
alt + shift + 2  : komorebic move-to-monitor-workspace 0 1
alt + shift + 3  : komorebic move-to-monitor-workspace 0 2
alt + shift + 4  : komorebic move-to-monitor-workspace 0 3
alt + shift + 5  : komorebic move-to-monitor-workspace 1 0
alt + shift + 6  : komorebic move-to-monitor-workspace 1 1
alt + shift + 7  : komorebic move-to-monitor-workspace 1 2
alt + shift + 8  : komorebic move-to-monitor-workspace 1 3
alt + shift + 9  : komorebic move-to-monitor-workspace 1 4

# --- Monitor focus ---
alt + shift + right : komorebic cycle-monitor next
alt + tab           : komorebic focus-last-workspace
