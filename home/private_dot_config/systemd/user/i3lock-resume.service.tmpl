# ~/.config/systemd/user/i3lock-resume.service
# Managed by Chezmoi: {{ .chezmoi.sourceFile }}
# Locks the screen using i3lock upon resuming from suspend.

[Unit]
Description=Lock screen on resume using i3lock
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=simple
# GDM assigns the user X session to :1 (not :0 which is the greeter).
# Without this, i3lock can't find the display after resume.
Environment=DISPLAY=:1
Environment=XAUTHORITY={{ .chezmoi.homeDir }}/.Xauthority

# Wait for autorandr and the NVIDIA driver to finish re-initialising the
# display before trying to grab input — grabbing too early causes
# "Cannot grab pointer/keyboard" which leaves the screen unlocked/blank.
ExecStartPre=/bin/sleep 3

ExecStart=/usr/bin/i3lock-color --insidevercolor=50fa7bff --insidewrongcolor=ff5555ff --insidecolor=44475acc --ringvercolor=50fa7bff --ringwrongcolor=ff5555ff --ringcolor=6272a4ff --keyhlcolor=8be9fdff --bshlcolor=ff79c6ff --verifcolor=f8f8f2ff --wrongcolor=f8f8f2ff --indicator --radius 120 --ring-width 10 --ignore-empty-password --pass-media-keys --pass-screen-keys --pass-power-keys

# Retry if the grab still fails (e.g. compositor not ready).
Restart=on-failure
RestartSec=2
StartLimitBurst=4
StartLimitIntervalSec=30

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
