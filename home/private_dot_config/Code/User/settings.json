{
  // -------------------------------------------------------------------------
  // EDITOR: APPEARANCE & BEHAVIOR
  // -------------------------------------------------------------------------
  "workbench.colorTheme": "Dracula", // Or your preferred theme like "Monokai", "One Dark Pro"
  "workbench.iconTheme": "material-icon-theme", // Or "vscode-icons", "file-icons"
  "editor.fontFamily": "'Fira Code', 'Droid Sans Mono', 'monospace', monospace", // Ensure Fira Code (or your choice) is installed
  "editor.fontLigatures": true, // Enable font ligatures if your font supports them (like Fira Code)
  "editor.fontSize": 14,
  "editor.fontWeight": "normal",
  "editor.lineHeight": 22,
  "editor.letterSpacing": 0.2,
  "editor.wordWrap": "on", // "off", "wordWrapColumn", "bounded"
  "editor.minimap.enabled": true,
  "editor.renderWhitespace": "boundary", // "none", "selection", "trailing", "all"
  "editor.cursorStyle": "line", // "block", "underline"
  "editor.cursorBlinking": "blink",
  "editor.multiCursorModifier": "ctrlCmd", // "alt" on Windows/Linux by default, "ctrlCmd" for macOS like behavior
  "breadcrumbs.enabled": true,
  "explorer.compactFolders": true,
  "window.zoomLevel": 0,
  "editor.suggestSelection": "first", // "recentlyUsed"
  "editor.rulers": [80, 100, 120],
  "editor.linkedEditing": true, // For HTML/XML tag renaming

  // -------------------------------------------------------------------------
  // EDITOR: FILES & SAVING
  // -------------------------------------------------------------------------
  "files.eol": "\n", // Essential for cross-platform consistency, use "\n" for LF
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "afterDelay", // "off", "onFocusChange", "onWindowChange"
  "files.autoSaveDelay": 1000,

  // -------------------------------------------------------------------------
  // EDITOR: FORMATTING & LINTING (Global Defaults)
  // -------------------------------------------------------------------------
  "editor.defaultFormatter": "esbenp.prettier-vscode", // Set your most common global default
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit", // Use "explicit" for ESLint for JS/TS
      "source.organizeImports": "explicit" // For JS/TS, Python (via Pylance/Pyright)
  },

  // -------------------------------------------------------------------------
  // LANGUAGE-SPECIFIC SETTINGS
  // -------------------------------------------------------------------------
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer", // rust-analyzer provides rustfmt
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    // rust-analyzer specific settings (optional, defaults are usually good)
    // "rust-analyzer.checkOnSave.command": "clippy", // Use clippy for linting on save (more thorough)
    // "rust-analyzer.inlayHints.enable": true, // Show type hints, etc.
    // "rust-analyzer.lens.enable": true, // Show Run | Debug lenses above main/tests
    // "rust-analyzer.hover.actions.enable": true, // Show actions like "Go to Type Definition" on hover
  },
  "[c]": { // Settings for C files
      "editor.defaultFormatter": "xaver.clang-format",
      "editor.formatOnSave": true,
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?", // C/C++ specific word separators
      "C_Cpp.default.intelliSenseMode": "linux-gcc-x64", // Or "macos-clang-x64", "windows-msvc-x64" - adjust per OS or let it auto-detect
      // "C_Cpp.clang_format_path": null, // Set if clang-format is not in PATH
      "C_Cpp.clang_format_style": "LLVM", // "file", "Google", "LLVM", "Mozilla", "WebKit" - "file" respects .clang-format
      // "C_Cpp.codeAnalysis.clangTidy.enabled": false, // Enable if you use clang-tidy
  },
  "[cpp]": { // Settings for C++ files
      "editor.defaultFormatter": "ms-vscode.cpptools", // Uses clang-format
      "editor.formatOnSave": true,
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?", // C/C++ specific word separators
      "C_Cpp.default.intelliSenseMode": "linux-gcc-x64", // Or "macos-clang-x64", "windows-msvc-x64" - adjust per OS or let it auto-detect
      "C_Cpp.default.cppStandard": "c++17", // Or "c++14", "c++20", "c++23"
      // "C_Cpp.clang_format_path": null, // Set if clang-format is not in PATH
      // "C_Cpp.clang_format_style": "file", // "file", "Google", "LLVM", "Mozilla", "WebKit" - "file" respects .clang-format
      // "C_Cpp.codeAnalysis.clangTidy.enabled": false, // Enable if you use clang-tidy
  },
  "[toml]": { // For Cargo.toml and other TOML files
      "editor.defaultFormatter": "tamasfe.even-better-toml" // If you install this extension
  },
  "[cmake]": { // If you use CMake
      "editor.defaultFormatter": "cheshirekow.cmake-format" // If you install this extension
  },

  "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter", // or "ms-python.autopep8"
      "editor.tabSize": 4,
      "editor.insertSpaces": true,
      "editor.formatOnSave": true,
      // Example: "python.analysis.typeCheckingMode": "basic",
      // Example: "python.linting.pylintEnabled": true, (if using pylint)
      // Example: "python.linting.flake8Enabled": true, (if using flake8)
  },
  "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2,
      "editor.formatOnSave": true
  },
  "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2,
      "editor.formatOnSave": true
  },
  "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2
  },
  "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2
  },
  "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode", // Or "vscode.json-language-features"
      "editor.tabSize": 2
  },
  "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode", // Or "vscode.json-language-features"
      "editor.tabSize": 2
  },
  "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode", // Or "vscode.html-language-features"
      "editor.tabSize": 2
  },
  "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2
  },
  "[scss]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2
  },
  "[markdown]": {
      "editor.defaultFormatter": "yzhang.markdown-all-in-one", // Or other markdown formatter
      "editor.wordWrap": "on",
      "editor.tabSize": 4,
      "editor.quickSuggestions": {
          "other": "on",
          "comments": "on",
          "strings": "on"
      }
  },
  "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml",
      "editor.tabSize": 2,
      "editor.autoIndent": "advanced"
  },
  "[dockerfile]": {
      "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },

  // -------------------------------------------------------------------------
  // TERMINAL SETTINGS
  // -------------------------------------------------------------------------
  "terminal.integrated.fontFamily": "monospace", // Or your preferred terminal font
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.defaultProfile.linux": "bash", // Or "zsh", "fish"
  "terminal.integrated.defaultProfile.osx": "zsh",   // Or "bash"
  "terminal.integrated.defaultProfile.windows": "PowerShell", // Or "Git Bash", "Command Prompt"
  // "terminal.integrated.shell.linux": "/bin/zsh", // If you need to specify an exact path
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.wordSeparators": " ./\\()\"'-_,.;<>~!@#$%^&*|+=[]{}`~?:",
  "terminal.integrated.scrollback": 5000,

  // -------------------------------------------------------------------------
  // VERSION CONTROL (GIT)
  // -------------------------------------------------------------------------
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "diffEditor.ignoreTrimWhitespace": false, // Set to true if you prefer to ignore whitespace changes in diff
  "scm.defaultViewMode": "tree", // "list" or "tree"

  // -------------------------------------------------------------------------
  // EXTENSION-SPECIFIC SETTINGS (Add configurations for extensions you use)
  // -------------------------------------------------------------------------
  "prettier.enable": true,
  "prettier.singleQuote": false, // Or true based on your preference
  "prettier.tabWidth": 2,        // Default, often overridden by language-specific
  "prettier.semi": true,
  "prettier.useTabs": false,
  "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "html",
      "vue"
  ],
  "eslint.run": "onType", // "onSave"
  "eslint.format.enable": true, // Allow ESLint to also format (can conflict with Prettier if both enabled for formatting)
  "python.analysis.typeCheckingMode": "basic", // For Pylance/Pyright. "off", "basic", "strict"
  "python.analysis.diagnosticMode": "workspace", // "openFilesOnly" or "workspace"
  "python.languageServer": "Default", // Usually Pylance if ms-python.vscode-pylance is installed
  "black-formatter.args": [], // For ms-python.black-formatter
  // "autopep8.args": ["--max-line-length=100"], // For ms-python.autopep8
  "jupyter.askForKernelRestart": false,
  "gitlens.hovers.currentLine.over": "line",

  // -------------------------------------------------------------------------
  // FILES & SEARCH EXCLUDES
  // -------------------------------------------------------------------------
  "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/*.pyc": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.venv": true,
      "**/.tox": true,
      "**/node_modules/": true,
      "**/bower_components/": true,
      "**/dist/": true,
      "**/build/": true,
      "**/*.egg-info/": true,
      "**/.coverage": true
  },
  "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      "**/yarn.lock": true,
      "**/package-lock.json": true,
      "**/dist": true,
      "**/build": true,
      "**/.venv": true,
      "**/.git": true
  },

  // -------------------------------------------------------------------------
  // WORKBENCH & WINDOW
  // -------------------------------------------------------------------------
  "workbench.startupEditor": "welcomePage", // "none", "newUntitledFile", "welcomePageInEmptyWorkbench"
  "workbench.editor.enablePreview": true,
  "workbench.editor.labelFormat": "default", // "short", "medium", "long"
  "workbench.activityBar.visible": true,
  "workbench.sideBar.location": "left",

  // -------------------------------------------------------------------------
  // TELEMETRY & SECURITY
  // -------------------------------------------------------------------------
  "telemetry.telemetryLevel": "off", // "all", "error", "crash", "off" - Your preference
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.startupPrompt": "once"
}