#!/bin/bash
# {{/* This is a Chezmoi template.
#      It installs VS Code extensions listed in vscode_extensions.txt
#      and optionally uninstalls extensions not in the list.
# */}}

set -eufo pipefail # Secure script execution

# Path to your list of extensions within the Chezmoi source directory
EXTENSIONS_FILE="{{ .chezmoi.sourceDir }}/vscode_extensions.txt"

# Check if VS Code 'code' command is available
if ! command -v code &> /dev/null; then
    # On some systems, 'code' might be named 'code-insiders', or need to be added to PATH
    # You might need to adjust this check or ensure 'code' is in your PATH.
    echo "VS Code 'code' command not found in PATH. Skipping extension management."
    # Try common installation paths if 'code' command not found
    if [ -f "/usr/share/code/bin/code" ]; then
        CODE_CMD="/usr/share/code/bin/code"
    elif [ -f "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" ]; then
        CODE_CMD="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
    # Add other paths if necessary, e.g., for Snap installs or user-local installs
    # elif [ -f "$HOME/.local/bin/code" ]; then
    #    CODE_CMD="$HOME/.local/bin/code"
    else
        echo "Could not find VS Code executable automatically. Please ensure 'code' is in your PATH."
        exit 0 # Exit gracefully, don't fail the chezmoi apply
    fi
else
    CODE_CMD="code"
fi

echo "Managing VS Code extensions using: $CODE_CMD"

# Get currently installed extensions
# The sed part is to handle potential carriage returns if the list comes from Windows
INSTALLED_EXTENSIONS=$($CODE_CMD --list-extensions | sed 's/\r$//')

# Install extensions from file
while IFS= read -r extension_id || [[ -n "$extension_id" ]]; do
    extension_id=$(echo "$extension_id" | sed 's/\r$//' | xargs) # Trim whitespace and CR

    if [[ -z "$extension_id" ]] || [[ "$extension_id" == \#* ]]; then # Skip empty lines and comments
        continue
    fi

    # Check if extension is already installed (case-insensitive check)
    # Using a loop for grep to handle potential issues with grep -q and pipes in some shells
    is_installed=false
    echo "$INSTALLED_EXTENSIONS" | while IFS= read -r installed_ext_line; do
        if [[ "${installed_ext_line,,}" == "${extension_id,,}" ]]; then
            is_installed=true
            break
        fi
    done

    if ! $is_installed; then
        echo "Installing extension: ${extension_id}"
        if ! $CODE_CMD --install-extension "${extension_id}" --force; then
            echo "WARNING: Failed to install extension ${extension_id}. It might be a typo, deprecated, or a network issue."
        fi
    else
        echo "Extension already installed: ${extension_id}"
    fi
done < "$EXTENSIONS_FILE"

