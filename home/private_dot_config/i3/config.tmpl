# i3 config — Managed by chezmoi: {{ .chezmoi.sourceFile }}

# ── Variables ─────────────────────────────────────────────────────────────────
set $mod  Mod4
set $term {{ .terminal_cmd_linux | default "ghostty" }}
set $menu rofi -show drun -theme {{ .chezmoi.homeDir }}/.config/rofi/simple_theme.rasi

# ── Workspaces ────────────────────────────────────────────────────────────────
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

# ── Monitor assignments ───────────────────────────────────────────────────────
# Set based on `xrandr --query` output
set $monitor_left  {{ .monitor_left | default "DP-2" }}
set $monitor_right {{ .monitor_right | default "DP-0" }}

workspace $ws1  output $monitor_left
workspace $ws2  output $monitor_left
workspace $ws3  output $monitor_left
workspace $ws4  output $monitor_left
workspace $ws5  output $monitor_right
workspace $ws6  output $monitor_right
workspace $ws7  output $monitor_right
workspace $ws8  output $monitor_right
workspace $ws9  output $monitor_right

# ── Appearance ────────────────────────────────────────────────────────────────
font pango:FiraCode Nerd Font 10

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
smart_borders on
gaps inner 8
gaps outer 5
smart_gaps on
popup_during_fullscreen smart

set $bg      #282a36
set $bg-alt  #44475a
set $fg      #f8f8f2
set $comment #6272a4
set $purple  #bd93f9
set $red     #ff5555
set $yellow  #f1fa8c

#                       border    bg        text      indicator  child
client.focused          $purple   $bg       $fg       $purple    $purple
client.focused_inactive $bg-alt   $bg       $comment  $bg-alt    $bg-alt
client.unfocused        $bg       $bg       $comment  $bg        $bg
client.urgent           $red      $red      $fg       $red       $red

# ── Core keybindings ──────────────────────────────────────────────────────────
floating_modifier $mod

bindsym $mod+Return       exec $term
bindsym $mod+Shift+t      exec $term
bindsym $mod+Shift+q      kill
bindsym $mod+d            exec $menu
bindsym $mod+Shift+Return fullscreen toggle
bindsym $mod+f            floating toggle
bindsym $mod+Shift+space  floating toggle
bindsym $mod+space        focus mode_toggle

# Focus
bindsym $mod+h     focus left
bindsym $mod+j     focus down
bindsym $mod+k     focus up
bindsym $mod+l     focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+h     move left
bindsym $mod+Shift+j     move down
bindsym $mod+Shift+k     move up
bindsym $mod+Shift+l     move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Layout
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+minus resize shrink width 50 px or 5 ppt
bindsym $mod+equal resize grow width 50 px or 5 ppt

# Workspace switch
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ── App → workspace assignments ───────────────────────────────────────────────
assign [class="com.mitchellh.ghostty"]    $ws1
assign [class="Brave-browser"]            $ws2
assign [class="obsidian"]                 $ws3
assign [class="com.obsproject.Studio"]    $ws5
assign [class="Spotify"]                  $ws7

# ── Utilities ─────────────────────────────────────────────────────────────────
bindsym $mod+Control+l exec {{ .chezmoi.homeDir }}/.config/i3/scripts/lock.sh
bindsym $mod+Shift+s   exec {{ .chezmoi.homeDir }}/.config/i3/scripts/lock_and_suspend.sh
bindsym $mod+Shift+b   exec {{ .browser_cmd_linux | default "xdg-open http://" }}
bindsym $mod+Shift+f   exec thunar
bindsym $mod+p         exec --no-startup-id flameshot gui -p {{ .chezmoi.homeDir }}/Pictures/Screenshots
bindsym $mod+Shift+p   exec --no-startup-id flameshot full -c

# Volume
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +2% && {{ .chezmoi.homeDir }}/.config/i3/scripts/notify_volume.sh
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -2% && {{ .chezmoi.homeDir }}/.config/i3/scripts/notify_volume.sh
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && {{ .chezmoi.homeDir }}/.config/i3/scripts/notify_volume.sh

# Brightness
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5% && {{ .chezmoi.homeDir }}/.config/i3/scripts/notify_brightness.sh
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%- && {{ .chezmoi.homeDir }}/.config/i3/scripts/notify_brightness.sh

# Media
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# i3 session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# ── Startup ───────────────────────────────────────────────────────────────────
# Bring displays up FIRST, before anything paints — guarantees a 2nd monitor
# lights up even when no autorandr profile matches. See scripts/setup_displays.sh.
exec --no-startup-id {{ .chezmoi.homeDir }}/.config/i3/scripts/setup_displays.sh
exec --no-startup-id setxkbmap -option caps:swapescape
exec --no-startup-id feh --bg-scale {{ .chezmoi.homeDir }}/images/wallpaper.png
# picom DISABLED: GLX backend on NVIDIA renders windows transparent/garbled.
# Re-enable once xrender-sync-fence is verified working (picom.conf:141).
# exec --no-startup-id picom --daemon
exec --no-startup-id dunst
exec --no-startup-id xss-lock -- {{ .chezmoi.homeDir }}/.config/i3/scripts/lock.sh
exec_always --no-startup-id {{ .chezmoi.homeDir }}/.config/polybar/launch.sh

# Startup apps — workspace placement handled by assign rules above
exec --no-startup-id {{ .terminal_cmd_linux | default "ghostty" }}
exec --no-startup-id brave-browser
exec --no-startup-id obsidian
exec --no-startup-id obs
exec --no-startup-id spotify
exec --no-startup-id i3-msg 'workspace number 1'
