# ~/.config/i3/config - i3 config file
# Managed by Chezmoi: {{ .chezmoi.sourceFile }}
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

# -----------------------------------------------------------------------------
# Variables
# -----------------------------------------------------------------------------
set $mod Mod4          # Mod4 is the Super key (Windows key)
set $alt Mod1          # Alt key

# Your preferred terminal emulator
set $term {{ .terminal | default "alacritty" }} # Get from chezmoi data or default to alacritty

# Your preferred application launcher (dmenu or rofi)
set $menu rofi -show drun -theme {{ .chezmoi.homeDir }}/.config/rofi/custom_theme.rasi
# set $menu dmenu_run -fn 'Fira Code-10' -nb '#282a36' -nf '#f8f8f2' -sb '#6272a4' -sf '#f8f8f2' # If using dmenu

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Fira Code Regular 10, Font Awesome 6 Free Solid 10
# Use a pango font to enable FontAwesome icons. Ensure these fonts are installed.

# -----------------------------------------------------------------------------
# Colors (Dracula Theme Inspired)
# -----------------------------------------------------------------------------
# class                 border  backgr. text    indicator child_border
set $bg-color           #282a36
set $inactive-bg-color  #282a36
set $text-color         #f8f8f2
set $inactive-text-color #6272a4
set $urgent-bg-color    #ff5555
set $urgent-text-color  #f8f8f2
set $placeholder-color  #21222C

set $focused-border     #bd93f9
set $focused-inactive-border #44475a
set $unfocused-border   #21222C
set $urgent-border      #ff5555

client.focused          $focused-border $bg-color $text-color $bd93f9   $focused-border
client.focused_inactive $focused-inactive-border $inactive-bg-color $inactive-text-color $44475a $focused-inactive-border
client.unfocused        $unfocused-border $inactive-bg-color $inactive-text-color $44475a $unfocused-border
client.urgent           $urgent-border $urgent-bg-color $urgent-text-color $ffb86c   $urgent-border
client.placeholder      $placeholder-color $bg-color $text-color $placeholder-color $unfocused-border
client.background       $bg-color

# -----------------------------------------------------------------------------
# Window Behavior & Appearance
# -----------------------------------------------------------------------------
# Use Mouse+$mod to drag floating windows to their new position
floating_modifier $mod

# Focus follows mouse, or not
# focus_follows_mouse no

# New windows open where? (smart, first)
# new_window pixel 1
# new_float pixel 1

# Default orientation for new containers
# default_orientation horizontal

# Gaps (inner and outer)
gaps inner 8
gaps outer 5

# Smart gaps (gaps only when multiple windows on workspace)
smart_gaps on
smart_borders on

# Set border style
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Popups during fullscreen mode
popup_during_fullscreen smart # smart, all, leave_fullscreen

# -----------------------------------------------------------------------------
# Keybindings
# -----------------------------------------------------------------------------

# Start a terminal
bindsym $mod+Return exec $term

# Kill focused window
bindsym $mod+Shift+q kill

# Start your application launcher
bindsym $mod+d exec $menu

# Change focus (Vim-like)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
# Or use arrow keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window (Vim-like)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
# Or use arrow keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split in horizontal orientation
bindsym $mod+b split h

# Split in vertical orientation
bindsym $mod+v split v

# Enter fullscreen mode for the focused window
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Focus the parent container
bindsym $mod+a focus parent

# Focus the child container
# bindsym $mod+d focus child

# Define names for workspaces
# Assign icons using Font Awesome or Nerd Fonts if available
set $ws1 "1: "  # Web (Firefox icon)
set $ws2 "2: "  # Terminal (Terminal icon)
set $ws3 "3: "  # Files/Text (File icon)
set $ws4 "4: "  # Media (Play icon)
set $ws5 "5: "  # Chat (Comments icon)
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10: " # Settings (Cog icon)

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace (preserves your layout/session)
bindsym $mod+Shift+r restart

# Exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Resize window (you can also use the mouse for nowadays)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Lock screen
# Using custom lock script for better visuals / blur if picom is active
bindsym $mod+Control+l exec {{ .chezmoi.homeDir }}/.config/i3/scripts/lock.sh
# bindsym $mod+Control+l exec i3lock -c 282a36 # Simple i3lock

# Screenshot
bindsym Print exec --no-startup-id flameshot gui
# bindsym Print exec --no-startup-id scrot '%Y-%m-%d-%H%M%S_$wx$h_scrot.png' -e 'mv $f ~/Pictures/Screenshots/'
bindsym Shift+Print exec --no-startup-id flameshot full -c # Copy full screen to clipboard

# Volume control (uses pactl for PulseAudio/PipeWire, assumes sink 0 or @DEFAULT_SINK@)
# You might need to adjust sink names/numbers or use amixer for ALSA
# Font Awesome icons used for notifications
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send -h string:x-canonical-private-synchronous:audio_volume -u low " Volume: $(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]{1,3}(?=%)' | head -n 1)%"
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && notify-send -h string:x-canonical-private-synchronous:audio_volume -u low " Volume: $(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]{1,3}(?=%)' | head -n 1)%"
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && notify-send -h string:x-canonical-private-synchronous:audio_volume_mute -u low "$([ $(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}') = "yes" ] && echo " Muted" || echo " Unmuted")"

# Media player controls (uses playerctl)
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioStop exec --no-startup-id playerctl stop

# Brightness control (uses light or xbacklight - ensure one is installed)
# Using 'light' as it's often more reliable than xbacklight
bindsym XF86MonBrightnessUp exec --no-startup-id light -A 5 && notify-send -h string:x-canonical-private-synchronous:brightness -u low " Brightness: $(light -G | cut -d'.' -f1)%"
bindsym XF86MonBrightnessDown exec --no-startup-id light -U 5 && notify-send -h string:x-canonical-private-synchronous:brightness -u low " Brightness: $(light -G | cut -d'.' -f1)%"

# -----------------------------------------------------------------------------
# Status Bar (i3bar with i3status-rust)
# -----------------------------------------------------------------------------
bar {
        # status_command i3status # Default i3status
        status_command i3status-rust -c {{ .chezmoi.homeDir }}/.config/i3status-rust/config.toml
        position top
        # tray_output primary # Or specific output like eDP-1, DP-1
        tray_padding 2

        font pango:Fira Code Regular 10, Font Awesome 6 Free Solid 10

        colors {
                background $bg-color
                statusline $text-color
                separator  $inactive-text-color

                #                      border  background text
                focused_workspace     $focused-border $focused-border $text-color
                active_workspace      $focused-inactive-border $focused-inactive-border $text-color
                inactive_workspace    $unfocused-border $bg-color $inactive-text-color
                urgent_workspace      $urgent-border $urgent-bg-color $urgent-text-color
                binding_mode          $urgent-border $urgent-bg-color $text-color
        }
}

# -----------------------------------------------------------------------------
# Startup Applications
# -----------------------------------------------------------------------------
# exec --no-startup-id <command>

# Set wallpaper using feh
exec --no-startup-id feh --bg-fill {{ .chezmoi.homeDir }}/.config/i3/wallpaper.png

# Start picom compositor
exec --no-startup-id picom --config {{ .chezmoi.homeDir }}/.config/picom/picom.conf

# Network manager applet (if you use one)
exec --no-startup-id nm-applet

# Notification daemon
exec --no-startup-id dunst -conf {{ .chezmoi.homeDir }}/.config/dunst/dunstrc

# Authentication agent (e.g., polkit-gnome for PolicyKit)
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Path might vary, check your system

# Setup monitors (if you have a script for it)
exec --no-startup-id {{ .chezmoi.homeDir }}/.config/i3/scripts/monitor_setup.sh

# Start some applications on specific workspaces (examples)
# assign [class="(?i)firefox"] $ws1
# assign [class="(?i)alacritty"] $ws2
# exec --no-startup-id firefox
# exec --no-startup-id $term

# For window rules (e.g., making certain windows always float)
# for_window [class="Galculator"] floating enable
# for_window [class="Nitrogen"] floating enable sticky enable border pixel 1
# for_window [window_role="pop-up"] floating enable
# for_window [window_role="bubble"] floating enable
# for_window [window_role="task_dialog"] floating enable
# for_window [window_role="Preferences"] floating enable
# for_window [window_type="dialog"] floating enable
# for_window [window_type="menu"] floating enable

# -----------------------------------------------------------------------------
# Autostart Programs Using .desktop files (XDG Autostart)
# -----------------------------------------------------------------------------
# Many desktop applications use XDG autostart. If you want to prevent some from
# starting in i3, you can copy their .desktop files to ~/.config/autostart/
# and add "Hidden=true" or "OnlyShowIn=GNOME;XFCE;" (excluding i3).
# Alternatively, to run XDG autostart items:
# exec --no-startup-id dex -a -s /etc/xdg/autostart/:~/.config/autostart/
# (requires 'dex' package)

# End of i3 config
