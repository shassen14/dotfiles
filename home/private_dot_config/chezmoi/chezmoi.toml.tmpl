# Managed by Chezmoi
# Source: {{ .chezmoi.sourceFile | quote }}
# Target: ~/.config/chezmoi/chezmoi.toml

# Set sourceDir dynamically:
# 1. Look for DOTFILES_REPO_ROOT environment variable (set in CI).
# 2. If not found (running locally), default to "$HOME/dotfiles".
# 3. Append the '/home' subdirectory where source files live.
sourceDir = "{{ env "DOTFILES_REPO_ROOT" | default (printf "%s/dotfiles" .chezmoi.homeDir) }}/home"

# --- Data Section ---
[data]
  name = "Samir Hassen" # Or use Ansible/env vars if preferred
  email = "your_email@example.com" # Replace with your actual email
  terminal = "alacritty"
  editor = "nvim"
  browser = "brave"

  # Example of OS-specific data
{{ if eq .chezmoi.os "darwin" }}
  # macOS specific data can go here if needed later
{{ else if eq .chezmoi.os "linux" }}
  # Linux specific data can go here if needed later
{{ end }}

