# ~/.config/chezmoi/chezmoi.toml - Managed by Chezmoi
# Template location: {{ .chezmoi.sourceFile | quote }}

# Set the source directory to the 'home' subdirectory within the repo clone.
# We use .chezmoi.homeDir to make it portable across users/machines.
sourceDir = "{{ .chezmoi.homeDir }}/dotfiles/home"

# Use templating to add other dynamic data if needed
[data]
  name = "Samir Hassen" # Or use Ansible/env vars if preferred
  email = "your_email@example.com"
  # Example of OS-specific data (can also use '.chezmoi.os' directly in templates)
{{ if eq .chezmoi.os "darwin" }}
  # macOS specific data if needed
{{ else if eq .chezmoi.os "linux" }}
  # Linux specific data if needed
{{ end }}

# Add other chezmoi settings as needed (e.g., encryption, scripting config)
# [edit]
#   command = "code"
#   args = ["--wait"]