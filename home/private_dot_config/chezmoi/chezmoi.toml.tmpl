# home/private_dot_config/chezmoi/chezmoi.toml.tmpl
# Source: {{ .chezmoi.sourceFile | quote }}
# Target: ~/.config/chezmoi/chezmoi.toml

# This sourceDir should point to where 'chezmoi init' placed your 'home' subdir's contents.
sourceDir = "{{ .chezmoi.homeDir }}/.local/share/chezmoi/home"

# This [data] section will be written into ~/.config/chezmoi/chezmoi.toml
# It uses the data that was made available by .chezmoi.toml.tmpl during 'init --apply'.
[data]
  name = "Samir" # Gets .name from data established by .chezmoi.toml.tmpl
  email = "fake@email.com"
  terminal = "alacritty"
  editor = "nvim"
  browser = "brave-browser"
  terminal_app_name_mac = "Alacritty"
  browser_app_name_mac = "Brave Browser"
  terminal_cmd_linux = "alacritty"
  browser_cmd_linux = "brave-browser"
  is_macos = false # Boolean, no quotes needed
  is_linux = false

# Other settings like edit, diff, encryption for your ongoing local config
#[edit]
#  command = "{{ .editor }}"

[diff]
  command = "git"
  args = ["diff", "--no-pager", "--color=always"]

encryption = "gpg"