# Managed by Chezmoi
# Source: {{ .chezmoi.sourceFile | quote }}
# Target: ~/.config/chezmoi/chezmoi.toml

# Set sourceDir dynamically:
# 1. Look for DOTFILES_REPO_ROOT environment variable (set in CI).
# 2. If not found (running locally), default to "$HOME/dotfiles".
# 3. Append the '/home' subdirectory where source files live.
sourceDir = "{{ env "DOTFILES_REPO_ROOT" | default (printf "%s/dotfiles" .chezmoi.homeDir) }}/home"

# --- Data Section ---
[data]
  name = "Samir Hassen"
  email = "your_email@example.com"
  terminal_app_name_mac = "Alacritty"    # For macOS 'open -a'
  terminal_cmd_linux = "alacritty"     # For Linux exec
  browser_app_name_mac = "Brave Browser" # For macOS 'open -a'
  browser_cmd_linux = "brave-browser"   # For Linux exec
  editor = "nvim"

