# ~/.config/i3status/config_simple
# Managed by Chezmoi: {{ .chezmoi.sourceFile }}
# Simplistic i3status configuration

general {
    colors = true
    interval = 5
    output_format = "i3bar"
}

# Order of modules in the bar
order += "tztime local"
order += "load"
order += "disk /"
# order += "wireless _first_" # Uncomment if you have Wi-Fi
# order += "ethernet _first_" # Uncomment if you have Ethernet
# order += "battery all"      # Uncomment if you have a battery

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}

load {
    format = "L: %1min" # Only 1-minute load average
}

disk "/" {
    format = "/: %avail"
}

