# **CPU Temperature**
# Check path: ls /sys/class/thermal/thermal_zone*
cpu_temperature 0 {
    format = " %degrees°C" # Temperature icon
    path = "/sys/class/thermal/thermal_zone0/temp" # Adjust zone number if needed
    # max_threshold = 85
}

# **Date and Time**
tztime local {
    format = "  %Y-%m-%d   %H:%M:%S" # Calendar and Clock icons
}
