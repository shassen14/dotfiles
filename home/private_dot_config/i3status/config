# ~/.config/i3status/config or ~/.i3status.conf
# Managed by Chezmoi: {{ .chezmoi.sourceFile }}

general {
        output_format = "i3bar"
        colors = true
        interval = 5
        color_good = "#8AE234"      # Greenish
        color_degraded = "#FCE94F"  # Yellowish
        color_bad = "#EF2929"       # Reddish
}

# order += "ipv6"
order += "disk /"
# order += "disk /home"
order += "run_watch DHCP"
order += "run_watch VPN"
order += "wireless _first_" # Use the first wireless interface found
order += "ethernet _first_" # Use the first ethernet interface found
order += "battery all"
order += "load"
order += "memory"
order += "cpu_temperature 0"
order += "tztime local"
# For media controls with playerctl:
order += "run_watch MEDIA"

wireless _first_ {
        format_up = "W: (%quality at %essid, %bitrate) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining %emptytime"
        format_down = "No battery"
        status_chr = "⚡ CHR"
        status_bat = "🔋 BAT"
        status_unk = "? UNK"
        status_full = "☻ FULL"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 15
}

run_watch DHCP {
        pidfile = "/var/run/dhclient*.pid"
}

run_watch VPN {
        # Assuming a common OpenVPN pidfile, adjust if using something else like WireGuard
        pidfile = "/var/run/openvpn/*.pid"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}

load {
        format = "L: %1min %5min %15min"
}

memory {
        format = "MEM: %used / %total"
        threshold_degraded = "10%"
        format_degraded = "MEMORY < %available"
}

disk "/" {
        format = "/: %avail"
        # prefix_type = "binary" # Or "decimal"
}

cpu_temperature 0 {
        format = "T: %degrees °C"
        path = "/sys/class/thermal/thermal_zone0/temp" # Adjust path if needed
}

# Custom script for media player status using playerctl
run_watch MEDIA {
    # This will show "▶ Artist - Title" or "⏸ ..." or "⏹"
    # You need to create the script ~/.config/i3status/scripts/media_status.sh
    pidfile = "/tmp/i3status_media.pid" # Dummy pidfile, script runs continuously
    format = "%output"
    # The script should be executable and output a single line
    # command = "{{ .chezmoi.homeDir }}/.config/i3status/scripts/media_status.sh"
}
```*You'd need to create `~/.config/i3status/scripts/media_status.sh` for the playerctl integration.*

