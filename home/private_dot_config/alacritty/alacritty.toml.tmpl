# Managed by Chezmoi
# Source: {{ .chezmoi.sourceFile | quote }}
# Target: ~/.config/alacritty/alacritty.toml

# Basic environment setup
# [env]
#   TERM = "alacritty"

# Window configuration
[window]
  padding.x = 5
  padding.y = 5
  decorations = "full"

# Scrolling configuration
[scrolling]
  history = 10000

# Font configuration (Ensure your Nerd Font name is correct)
[font]
  size = 12.0
  [font.normal] # Define sub-table for normal font
    family = "FiraCode Nerd Font"

# Colors (Using Dracula example)
[colors.primary]
  background = "0x282a36"
  foreground = "0xf8f8f2"
[colors.cursor]
  text = "0x282a36"
  cursor = "0xf8f8f2"
[colors.normal]
  black = "0x000000"
  red = "0xff5555"
  green = "0x50fa7b"
  yellow = "0xf1fa8c"
  blue = "0xbd93f9"
  magenta = "0xff79c6"
  cyan = "0x8be9fd"
  white = "0xbfbfbf"
[colors.bright]
  black = "0x4d4d4d"
  red = "0xff6e6e"
  green = "0x69ff94"
  yellow = "0xffffa5"
  blue = "0xd6acff"
  magenta = "0xff92df"
  cyan = "0xa4ffff"
  white = "0xe6e6e6"

# Bell configuration
[bell]
  animation = "EaseOutExpo"
  duration = 100
  color = "0xffffff"

# Selection configuration
[selection]
  save_to_clipboard = true

# Mouse configuration (Reverted URL structure)
[mouse]
  hide_when_typing = true
  # Configure URL launching directly under [mouse]
  # This might be the structure your version expects
  # url = { launcher = { program = "{{ if eq .chezmoi.os "darwin" }}open{{ else }}xdg-open{{ end }}" }, modifiers = "None" }

# Terminal configuration (Corrected osc52 value)
[terminal]
  # Set OSC 52 option to a valid value like 'CopyPaste'
  osc52 = "CopyPaste" # <<< CORRECTED VALUE
  # Correct way to define the shell program and args
  shell = { program = "{{ if eq .chezmoi.os "darwin" }}/bin/zsh{{ else }}/bin/bash{{ end }}", args = [] }

