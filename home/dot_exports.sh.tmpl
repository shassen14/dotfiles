# ~/.exports.sh - Managed by Chezmoi
# Shared environment variables sourced by .zshrc and .bashrc

# Set preferred editor (change 'nvim' to 'vim', 'nano', 'code --wait', etc.)
export EDITOR='nvim'
export VISUAL="$EDITOR"

# Set pager
export PAGER='less'
export LESS='-F -g -i -M -R -S -w -X -z-4'

# Set default language/locale
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# Add GPG TTY if gpg is available (useful for commit signing)
if command -v tty >/dev/null; then
  export GPG_TTY=$(tty)
fi

# --- OS Specific Exports ---
{{ if eq .chezmoi.os "darwin" }}
# Example macOS Specific Exports (if any)
# export SOME_MAC_VAR="value"
{{ else if eq .chezmoi.os "linux" }}
# Example Linux Specific Exports (if any)
# export SOME_LINUX_VAR="value"
{{ end }}

# --- PATH Setup ---
# Start with the existing PATH
_NEW_PATH="$PATH"

# Prepend ~/bin if it exists
if [ -d "$HOME/bin" ]; then
  _NEW_PATH="$HOME/bin:$_NEW_PATH"
fi

# Prepend ~/.local/bin if it exists
if [ -d "$HOME/.local/bin" ]; then
  _NEW_PATH="$HOME/.local/bin:$_NEW_PATH"
fi

# Prepend /usr/local/bin (Common location for manual installs/brew on Linux)
# Add this unconditionally as tools like Starship often land here
_NEW_PATH="/usr/local/bin:$_NEW_PATH"

# Optional: Prepend /usr/local/sbin if needed for admin tools
# _NEW_PATH="/usr/local/sbin:$_NEW_PATH"

# Remove potential duplicate paths (requires awk/tr or specific shell features)
# Simple approach: Just export the potentially duplicated path for now
# More robust (Bash 4+):
# Read paths into an array, remove duplicates, join back
# declare -a path_arr
# IFS=: read -r -a path_arr <<< "$_NEW_PATH"
# declare -A seen
# declare -a unique_path_arr
# for p in "${path_arr[@]}"; do
#   [[ -z $p || ${seen[$p]} ]] && continue
#   unique_path_arr+=("$p")
#   seen[$p]=1
# done
# export PATH=$(IFS=:; echo "${unique_path_arr[*]}")
# --- OR --- Just export the built path (simpler, usually fine) ---
export PATH="$_NEW_PATH"
# --- End PATH Setup ---


# --- ASDF Version Manager Setup ---
# Add asdf to PATH and initialize completions
# Assumes asdf installed via git clone to ~/.asdf
# If installed via Brew, path might be different - adjust if necessary!
if [ -d "$HOME/.asdf" ]; then
  . "$HOME/.asdf/asdf.sh"
  # Append completions to fpath for zsh (handled differently in .zshrc/.bashrc below)
  # Bash completions usually sourced via a separate file or the main asdf.sh
fi


# Add any other cross-shell exports here
# export MY_VARIABLE="some_value"
