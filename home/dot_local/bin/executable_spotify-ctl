#!/bin/bash
# Control Spotify via playerctl. Usage: spotify-ctl play-pause|next|prev|vol+|vol-
case "${1:?Usage: spotify-ctl play-pause|next|prev|vol+|vol-}" in
    play-pause) playerctl -p spotify play-pause ;;
    next)       playerctl -p spotify next ;;
    prev)       playerctl -p spotify previous ;;
    vol+)       playerctl -p spotify volume 0.05+ ;;
    vol-)       playerctl -p spotify volume 0.05- ;;
    *)          echo "Unknown command: $1" >&2; exit 1 ;;
esac
