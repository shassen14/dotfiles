# ~/.zshrc.tmpl - Managed by Chezmoi
# Executed by zsh(1) for interactive shells.

# Source shared exports and aliases if they exist
if [ -f "${ZDOTDIR:-$HOME}/.exports.sh" ]; then
    . "${ZDOTDIR:-$HOME}/.exports.sh"
fi
if [ -f "${ZDOTDIR:-$HOME}/.aliases.sh" ]; then
    . "${ZDOTDIR:-$HOME}/.aliases.sh"
fi

# Override reload alias
alias reload='source "${ZDOTDIR:-$HOME}/.zshrc"'

# --- History ---
# (Your existing HISTFILE, HISTSIZE, SAVEHIST, setopt lines)
export HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
export HISTSIZE=10000
export SAVEHIST=20000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

# --- Keybindings ---
# Enable Vi mode if desired
# bindkey -v

# --- Keybindings for History Beginning Search ---
# Bind arrow keys directly to Zsh's built-in widgets

# Try binding using terminfo first (most portable)
if [[ -n "$terminfo[kcuu1]" ]] && [[ -n "$terminfo[kcud1]" ]]; then
  # *** USE BUILT-IN WIDGET NAMES ***
  bindkey -M main "$terminfo[kcuu1]" history-beginning-search-backward
  bindkey -M main "$terminfo[kcud1]" history-beginning-search-forward
  bindkey -M viins "$terminfo[kcuu1]" history-beginning-search-backward
  bindkey -M viins "$terminfo[kcud1]" history-beginning-search-forward
fi

# Bind common VT100/ANSI escape codes as fallback/alternative
# *** USE BUILT-IN WIDGET NAMES ***
bindkey -M main "^[[A" history-beginning-search-backward   # Map common Up Arrow code
bindkey -M main "^[[B" history-beginning-search-forward  # Map common Down Arrow code
bindkey -M viins "^[[A" history-beginning-search-backward # Map common Up Arrow code
bindkey -M viins "^[[B" history-beginning-search-forward # Map common Down Arrow code


# Bind application cursor key codes if necessary (e.g., ^[OA, ^[OB)
# *** USE BUILT-IN WIDGET NAMES ***
bindkey -M main "^[OA" history-beginning-search-backward   # Map alternate Up Arrow code
bindkey -M main "^[OB" history-beginning-search-forward  # Map alternate Down Arrow code
bindkey -M viins "^[OA" history-beginning-search-backward  # Map alternate Up Arrow code
bindkey -M viins "^[OB" history-beginning-search-forward # Map alternate Down Arrow code


# --- Completion System ---
# Initialize Zsh completion system
fpath=("$HOME/.zsh_functions" $fpath) # Add user functions dir to fpath
autoload -Uz compinit && compinit
# Case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
# Menu selection for completion
zstyle ':completion:*' menu select
# Group completions by type
zstyle ':completion:*:*:*:*:*' menu select
zstyle ':completion:*' group-name ''
# Enable completion caching
zstyle ':completion::complete:*' use-cache 1
# Add asdf completions if available (check path from .zshenv/.exports.sh)
if command -v asdf >/dev/null && [ -f "${ASDF_DIR}/completions/asdf.bash" ]; then # Check if asdf exists
  fpath=(${ASDF_DIR}/completions $fpath)
fi


# --- Starship Prompt ---
# Initialize Starship (must be last thing that affects prompt)
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi

# Add any other Zsh-specific interactive settings here

echo "Loaded ~/.zshrc" # Optional: for debugging